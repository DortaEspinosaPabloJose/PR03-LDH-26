<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>es.ull.esit</groupId>
    <artifactId>Exposito</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Exposito</name>
    <description>RTVRPTW / TOPTW: recomendador turistico con ventanas de tiempo (GRASP).</description>

    <properties>
        <!-- Version de Java. Cambiala a 11 u 8 si tu JDK es mas antiguo. -->
        <java.version>8</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Clase principal. Tras mover los paquetes al estandar, sera top.mainTOPTW -->
        <main.class>main.java.top.mainTOPTW</main.class>

        <!-- Versiones de dependencias y plugins -->
        <junit.version>5.11.4</junit.version>
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <surefire.plugin.version>3.5.2</surefire.plugin.version>
        <jar.plugin.version>3.4.2</jar.plugin.version>
        <install.plugin.version>3.1.3</install.plugin.version>
        <deploy.plugin.version>3.1.3</deploy.plugin.version>
        <jacoco.plugin.version>0.8.12</jacoco.plugin.version>
        <sonar.plugin.version>4.0.0.4121</sonar.plugin.version>
        <exec.plugin.version>3.5.0</exec.plugin.version>
        <javadoc.plugin.version>3.11.2</javadoc.plugin.version>
        <resources.plugin.version>3.3.1</resources.plugin.version>
        <clean.plugin.version>3.4.0</clean.plugin.version>

        <!-- SonarQube (servidor local). El token se pasa por linea de comandos:
             mvn verify sonar:sonar -Dsonar.token=TU_TOKEN -->
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.projectKey>es.ull.esit:Exposito</sonar.projectKey>
        <sonar.projectName>Exposito - TOPTW GRASP</sonar.projectName>
        <sonar.sourceEncoding>UTF-8</sonar.sourceEncoding>
        <sonar.java.source>${java.version}</sonar.java.source>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Layout estandar de Maven: src/main/java, src/main/resources, src/test/java -->
        <finalName>Exposito</finalName>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${clean.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${resources.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${install.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${deploy.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Compilacion -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <debug>true</debug>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Tests unitarios (JUnit 5). El argLine lo rellena JaCoCo -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
                <configuration>
                    <argLine>@{argLine} -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>

            <!-- Empaquetado: jar ejecutable con Main-Class -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Cobertura de tests (la consume SonarQube) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Analisis de calidad: mvn verify sonar:sonar -Dsonar.token=... -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.plugin.version}</version>
            </plugin>

            <!-- Ejecutar la aplicacion: mvn compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <workingDirectory>${project.basedir}</workingDirectory>
                </configuration>
            </plugin>

            <!-- Javadoc: mvn javadoc:javadoc (se genera en target/reports/apidocs) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${javadoc.plugin.version}</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Para que "mvn deploy" funcione sin servidor remoto: repositorio local en target/ -->
    <distributionManagement>
        <repository>
            <id>local-deploy-repo</id>
            <name>Repositorio local de despliegue</name>
            <url>file:${project.build.directory}/deploy-repo</url>
        </repository>
        <snapshotRepository>
            <id>local-deploy-snapshots</id>
            <name>Repositorio local de snapshots</name>
            <url>file:${project.build.directory}/deploy-repo</url>
        </snapshotRepository>
    </distributionManagement>
</project>